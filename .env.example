# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave service_role (Project Settings > API). Use apenas no servidor, nunca exponha.
# As tabelas têm RLS habilitado sem políticas, então a chave anon não terá acesso.
SUPABASE_KEY=sua-chave-service-role

# Fuso usado para calcular os períodos de !dia, !semana e !mes (opcional)
TIMEZONE=America/Sao_Paulo

